    {
      "key": "baseUrl",
      "value": "http://localhost:4242"
    },
    {
      "key": "mockApiUrl",
      "value": "http://localhost:5050"
    },
    {
      "key": "internalApiToken",
      "value": "replace_with_local_test_token"
    },
    {
      "key": "webhookSecret",
      "value": "whsec_replace_with_local_stripe_cli_secret"
    }
  ],
