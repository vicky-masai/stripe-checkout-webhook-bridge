    {
      "name": "Stripe webhook: signed checkout.session.completed",
      "request": {
        "method": "POST",
        "description": "Signed with {{webhookSecret}}. The service verifies the signature, maps the session and forwards it to the notification API.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"evt_1QTEST000000000000000001\",\n  \"object\": \"event\",\n  \"api_version\": \"2025-10-29.clover\",\n  \"created\": 1794873600,\n  \"data\": {\n    \"object\": {\n      \"id\": \"cs_test_a1B2c3D4e5F6\",\n      \"object\": \"checkout.session\",\n      \"amount_total\": 4999,\n      \"currency\": \"usd\",\n      \"customer_details\": {\n        \"email\": \"alex.rivera@example.test\"\n      },\n      \"payment_status\": \"paid\",\n      \"status\": \"complete\",\n      \"mode\": \"payment\"\n    }\n  },\n  \"livemode\": false,\n  \"pending_webhooks\": 1,\n  \"type\": \"checkout.session.completed\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/webhooks/stripe"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Sign the exact request body the way Stripe does: HMAC-SHA256 over \"<timestamp>.<body>\".",
              "const cryptoJs = require('crypto-js'); // built into the Postman sandbox",
              "const timestamp = Math.floor(Date.now() / 1000);",
              "const signature = cryptoJs.HmacSHA256(`${timestamp}.${pm.request.body.raw}`, pm.variables.get('webhookSecret')).toString();",
              "pm.request.headers.upsert({ key: 'Stripe-Signature', value: `t=${timestamp},v1=${signature}` });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('webhook accepts the signed event', () => pm.response.to.have.status(200));",
              "pm.test('event was forwarded (or already forwarded on an earlier run)', () => pm.expect(pm.response.json().status).to.be.oneOf(['forwarded', 'duplicate']));"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "200 OK (recorded from local run)",
          "originalRequest": {
            "method": "POST",
            "description": "Signed with {{webhookSecret}}. The service verifies the signature, maps the session and forwards it to the notification API.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_1QTEST000000000000000001\",\n  \"object\": \"event\",\n  \"api_version\": \"2025-10-29.clover\",\n  \"created\": 1794873600,\n  \"data\": {\n    \"object\": {\n      \"id\": \"cs_test_a1B2c3D4e5F6\",\n      \"object\": \"checkout.session\",\n      \"amount_total\": 4999,\n      \"currency\": \"usd\",\n      \"customer_details\": {\n        \"email\": \"alex.rivera@example.test\"\n      },\n      \"payment_status\": \"paid\",\n      \"status\": \"complete\",\n      \"mode\": \"payment\"\n    }\n  },\n  \"livemode\": false,\n  \"pending_webhooks\": 1,\n  \"type\": \"checkout.session.completed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/webhooks/stripe"
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ],
          "cookie": [],
          "body": "{\n  \"received\": true,\n  \"status\": \"forwarded\"\n}"
        }
      ]
