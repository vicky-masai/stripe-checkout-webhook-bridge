STRIPE_SECRET_KEY=sk_test_replace_with_your_own_test_key
PORT=4242
STRIPE_WEBHOOK_SECRET=whsec_replace_with_local_stripe_cli_secret
INTERNAL_API_URL=http://localhost:5050/internal/notifications
INTERNAL_API_TOKEN=replace_with_local_test_token
INTERNAL_API_TIMEOUT_MS=5000

# Optional. The bundled local receiver (http://localhost:5050) starts together
# with the webhook service. Set to false when INTERNAL_API_URL points at a
# real, authorised internal endpoint.
# START_MOCK_NOTIFICATION_API=false
# MOCK_API_PORT=5050
